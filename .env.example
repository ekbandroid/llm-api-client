# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не попадёт — он в .gitignore.

LLM_API_KEY=sk-впишите-сюда-свой-ключ
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Модель на своей машине: ключ не нужен, строку LLM_API_KEY можно оставить
# пустой или убрать вовсе — по адресу видно, что сервер локальный.
#   LM Studio:  LLM_BASE_URL=http://127.0.0.1:1234/v1
#   Ollama:     LLM_BASE_URL=http://127.0.0.1:11434/v1
# Имя модели смотрите в самом LM Studio или `ollama list`; кнопка ↻ во
# вкладке «Модель» покажет список прямо из интерфейса.

# Отметка выбранного провайдера. Пусто/что угодно иное — своя модель из
# LLM_*; cloud (или «облако») — облачная из CLOUD_* ниже. Проставляет её
# скрипт запуска (./run-local.sh --cloud) в окружении процесса, в .env
# задавать обычно не нужно. Читает llm.py при импорте.
#   LLM_PROVIDER=cloud

# Диалект API. По умолчанию определяется по адресу: у DeepSeek свои поля
# thinking и reasoning_effort, прочие серверы их не ждут, а строгие отвечают
# ошибкой 400. Пригодится, если свой сервер эти поля всё-таки понимает.
#   LLM_DIALECT=deepseek

# Режим thinking: true/false
LLM_THINKING=true
# Уровень рассуждений: low / medium / high
LLM_REASONING_EFFORT=high
# Системный промпт. ЗАКОММЕНТИРОВАН НАМЕРЕННО: пока переменной нет,
# приложение выбирает промпт по адресу модели — облачной общий английский,
# местной короткий русский, который прямо называет её задачу (небольшая модель
# из общих слов задачу не выводит). Зададите здесь — выбор отключится для обеих.
#   LLM_SYSTEM_PROMPT=You are a helpful assistant.
# Температура. Пусто — приложение решает по адресу: местной модели 0,2, облаку
# ничего не присылается вовсе. Ollama без этого поля берёт 0,8, и ответ по
# документу превращается из цитаты в пересказ. Запятая вместо точки допустима.
#   LLM_TEMPERATURE=0.2
# ОКНО КОНТЕКСТА у местной модели в запросе задать нельзя — такого поля нет в
# OpenAI-совместимом /v1. Окно берётся из параметров самой модели, а когда их
# нет — из OLLAMA_CONTEXT_LENGTH у сервера либо по умолчанию. Маленькое окно не
# ошибка, а молчаливая обрезка: запрос с выдержками не доезжает, и это выглядит
# как глупость модели. Соберите модель со своим окном — оно переедет вместе
# с ней и попадёт под версионный контроль:
#   ollama create llmchat-rag:3b -f local/Modelfile
#   LLM_MODEL=llmchat-rag:3b

# Адрес и имя модели для «своего» плеча в сравнении провайдеров
# (rag_compare.py). Это не то же, что LLM_BASE_URL/LLM_MODEL: сравнение
# ходит к обоим провайдерам подряд и берёт локальное плечо отсюда, чтобы
# не зависеть от текущего выбора в LLM_*. По умолчанию — привычный порт
# LM Studio и qwen2.5:3b.
#   LOCAL_BASE_URL=http://127.0.0.1:11434/v1
#   LOCAL_MODEL=qwen2.5:3b

# Яндекс OAuth — необязательно. Пока поля пусты, работает только вход
# по логину и паролю; заполните после публикации на домене.
# Приложение заводится на https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/callback
# Логины, которым выдаётся админ-доступ сразу при регистрации (через запятую)
ADMIN_LOGINS=
# Подпись сессионной куки: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# За TLS — true, чтобы сессионная кука не ходила по открытому HTTP
COOKIE_SECURE=false

# База переписки (SQLite). От неё же по умолчанию отсчитываются каталоги,
# которые ниже помечены «рядом с базой»: файлы агента, очередь заданий,
# индекс документов. Пусто — app.db в каталоге приложения.
#   DB_PATH=/свой/путь/app.db

# Свои MCP-серверы: адреса, по которым к ним ходит приложение.
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp
# Как представляться сервису met.no (запасной источник погоды). Запросы без
# внятного User-Agent он отклоняет. По умолчанию — строка проекта; впишите
# свой адрес, если met.no просит контакт.
#   MET_USER_AGENT=llmchat.me.uk weather MCP (ваша почта)
SCHEDULER_MCP_URL=http://127.0.0.1:8002/mcp
# Очередь заданий и файлы агента по умолчанию лежат рядом с базой переписки
# (каталог из DB_PATH). Эти переменные нужны, только если хочется иначе.
# SCHEDULER_DB_PATH=/свой/путь/scheduler.db
# FILES_DIR=/свой/путь/files
# Часовой пояс, в котором планировщик называет время (сервер живёт в UTC)
SCHEDULER_TZ=Europe/Moscow
# Как часто приложение заглядывает в очередь заданий, секунд
JOB_TICK_SECONDS=30
# Сервер поиска и пересказа
RESEARCH_MCP_URL=http://127.0.0.1:8003/mcp
# Как представляться Википедии: без внятного User-Agent она рано или поздно
# отвечает 403. По умолчанию — строка проекта; впишите свой контакт, если
# Википедия начнёт отклонять запросы.
#   WIKI_USER_AGENT=llmchat.me.uk research MCP (ваша почта)
# Показывать ли модели поиск по Википедии. По умолчанию решается по адресу
# модели: местной — выключен (небольшая модель уходит в поиск даже когда
# ответ лежит в выдержках), облачной — включён. Переопределение: on/off.
#   RESEARCH_WIKI=off
# Текст правил ответа, который уходит модели вместе с выдержками: полный или
# короткий. По умолчанию — короткий для местной модели, полный для облачной.
#   RESEARCH_ANSWER_RULES=terse        # или full
# Куда кладётся индекс документов (RAG) и каталог с исходными файлами набора.
# По умолчанию — рядом с базой переписки (каталог из DB_PATH).
#   RAG_DB_PATH=/свой/путь/rag.db
#   RAG_SOURCES_DIR=/свой/путь/rag-sources
# Куда кладутся модели, переведённые в половинную точность (наша копия, не
# кэш HuggingFace). По умолчанию — каталог models рядом с базой переписки.
#   RAG_MODELS_DIR=/свой/путь/models
# Какая модель эмбеддингов берётся по умолчанию: multilingual / retrieval-en / code
#   RAG_MODEL=multilingual
# Сервер про сам проект: ветка, изменённые файлы, diff, коммиты. Локальный —
# на сервере приложения истории нет вовсе, код кладётся git archive'ом.
PROJECT_MCP_URL=http://127.0.0.1:8004/mcp
# Корень репозитория, о котором спрашивают через /help. По умолчанию — каталог
# самого приложения. Инструментам git корень приходит отсюда, а не от модели:
# иначе они читали бы любой репозиторий на машине.
# PROJECT_ROOT=/свой/путь/к/репозиторию
# Облачная модель для локального запуска: ./run-local.sh --cloud
#
# Отдельный набор переменных, а не правка LLM_* выше, по одной причине:
# переключение между своей моделью и облачной должно быть обратимым одной
# буквой в команде, не переписывая .env и не забыв вернуть его назад. Те же
# имена уже использует rag_compare.py, когда сравнивает двух провайдеров.
#
# Читает их сам llm.py, а не скрипт запуска: .env разбирает python-dotenv, и
# шеллу он не виден — ключу незачем идти к процессу через переменные шелла.
# Скрипт экспортирует только отметку LLM_PROVIDER=cloud.
#
# Переключается при этом всё разом: адрес, диалект, системный промпт,
# температура, пределы ожидания, коэффициенты токенов, Википедия и правила
# ответа. Половинчатого режима «чат на своей, команды в облако» нет намеренно —
# сервер поиска живёт отдельным процессом, и его условия задаются при запуске.
CLOUD_BASE_URL=https://api.deepseek.com
CLOUD_MODEL=deepseek-flash
CLOUD_API_KEY=
# Очередь поддержки: тикеты и пользователи. Сервер читает json при каждом
# обращении, а не при запуске — обращение могли завести минуту назад.
SUPPORT_MCP_URL=http://127.0.0.1:8005/mcp
# SUPPORT_DATA=/свой/путь/tickets.json
