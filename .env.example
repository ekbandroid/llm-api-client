# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не попадёт — он в .gitignore.

LLM_API_KEY=sk-впишите-сюда-свой-ключ
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Модель на своей машине: ключ не нужен, строку LLM_API_KEY можно оставить
# пустой или убрать вовсе — по адресу видно, что сервер локальный.
#   LM Studio:  LLM_BASE_URL=http://127.0.0.1:1234/v1
#   Ollama:     LLM_BASE_URL=http://127.0.0.1:11434/v1
# Имя модели смотрите в самом LM Studio или `ollama list`; кнопка ↻ во
# вкладке «Модель» покажет список прямо из интерфейса.

# Диалект API. По умолчанию определяется по адресу: у DeepSeek свои поля
# thinking и reasoning_effort, прочие серверы их не ждут, а строгие отвечают
# ошибкой 400. Пригодится, если свой сервер эти поля всё-таки понимает.
#   LLM_DIALECT=deepseek

# Режим thinking: true/false
LLM_THINKING=true
# Уровень рассуждений: low / medium / high
LLM_REASONING_EFFORT=high
# Системный промпт. ЗАКОММЕНТИРОВАН НАМЕРЕННО: пока переменной нет,
# приложение выбирает промпт по адресу модели — облачной общий английский,
# местной короткий русский, который прямо называет её задачу (небольшая модель
# из общих слов задачу не выводит). Зададите здесь — выбор отключится для обеих.
#   LLM_SYSTEM_PROMPT=You are a helpful assistant.
# Температура. Пусто — приложение решает по адресу: местной модели 0,2, облаку
# ничего не присылается вовсе. Ollama без этого поля берёт 0,8, и ответ по
# документу превращается из цитаты в пересказ. Запятая вместо точки допустима.
#   LLM_TEMPERATURE=0.2
# ОКНО КОНТЕКСТА у местной модели в запросе задать нельзя — такого поля нет в
# OpenAI-совместимом /v1. Окно берётся из параметров самой модели, а когда их
# нет — из OLLAMA_CONTEXT_LENGTH у сервера либо по умолчанию. Маленькое окно не
# ошибка, а молчаливая обрезка: запрос с выдержками не доезжает, и это выглядит
# как глупость модели. Соберите модель со своим окном — оно переедет вместе
# с ней и попадёт под версионный контроль:
#   ollama create llmchat-rag:3b -f local/Modelfile
#   LLM_MODEL=llmchat-rag:3b

# Яндекс OAuth — необязательно. Пока поля пусты, работает только вход
# по логину и паролю; заполните после публикации на домене.
# Приложение заводится на https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/callback
# Логины, которым выдаётся админ-доступ сразу при регистрации (через запятую)
ADMIN_LOGINS=
# Подпись сессионной куки: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# За TLS — true, чтобы сессионная кука не ходила по открытому HTTP
COOKIE_SECURE=false

# Свои MCP-серверы: адреса, по которым к ним ходит приложение.
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp
SCHEDULER_MCP_URL=http://127.0.0.1:8002/mcp
# Очередь заданий и файлы агента по умолчанию лежат рядом с базой переписки
# (каталог из DB_PATH). Эти переменные нужны, только если хочется иначе.
# SCHEDULER_DB_PATH=/свой/путь/scheduler.db
# FILES_DIR=/свой/путь/files
# Часовой пояс, в котором планировщик называет время (сервер живёт в UTC)
SCHEDULER_TZ=Europe/Moscow
# Как часто приложение заглядывает в очередь заданий, секунд
JOB_TICK_SECONDS=30
# Сервер поиска и пересказа
RESEARCH_MCP_URL=http://127.0.0.1:8003/mcp
