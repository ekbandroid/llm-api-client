# Секреты. Маска со звёздочкой не случайна: правило «.env» закрывает только
# это имя, а любая копия рядом — .env.local, .env.backup-2026 — оказалась бы
# в коммите вместе с ключом. Один раз такая копия уже появилась.
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc
.idea/
.vscode/
.claude/
# SQLite: сама база и служебные файлы WAL-режима
*.db
*.db-wal
*.db-shm

# Локальные заметки по развёртыванию — не для репозитория
DEPLOY.local.md

# Файлы, которые агент сохраняет по просьбе
files/

# Загруженные документы для поиска
rag-sources/

# Модели эмбеддингов в половинной точности
models/
