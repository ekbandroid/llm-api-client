; MCP-сервер поиска, пересказа и файлов.
;
; Ищет в Википедии, пересказывает своим обращением к модели (ключ берётся из
; того же /opt/llmchat/app/.env, что и у приложения) и сохраняет результат в
; /opt/llmchat/data/files. Отсюда ReadWritePaths: ProtectSystem=strict иначе
; не даёт писать никуда.
;
; Установка на сервере:
;   sudo cp /opt/llmchat/app/deploy/llmchat-research.service /etc/systemd/system/
;   sudo systemctl daemon-reload && sudo systemctl enable --now llmchat-research

[Unit]
Description=LLM chat research MCP (поиск, пересказ, файлы)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=llmchat
Group=llmchat
WorkingDirectory=/opt/llmchat/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=FILES_DIR=/opt/llmchat/data/files
ExecStart=/opt/llmchat/venv/bin/uvicorn research_mcp:app --host 127.0.0.1 --port 8003 --workers 1
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/llmchat/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
