; MCP-сервер поиска, пересказа и файлов.
;
; Ищет в Википедии, пересказывает своим обращением к модели (ключ берётся из
; того же /opt/llmchat/app/.env, что и у приложения) и сохраняет результат
; рядом с базой переписки — путь считается от DB_PATH, чтобы у приложения и
; сервера он был один. Отсюда ReadWritePaths: ProtectSystem=strict иначе не
; даёт писать никуда.
;
; Здесь же живут модели эмбеддингов и поиск по загруженным документам: модели
; держатся в памяти резидентно (244 МБ во float16), и второй процесс с той же
; моделью удвоил бы расход.
;
; Установка на сервере:
;   sudo cp /opt/llmchat/app/deploy/llmchat-research.service /etc/systemd/system/
;   sudo systemctl daemon-reload && sudo systemctl enable --now llmchat-research

[Unit]
Description=LLM chat research MCP (поиск, пересказ, файлы)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=llmchat
Group=llmchat
WorkingDirectory=/opt/llmchat/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
; Кэш моделей эмбеддингов: по умолчанию HuggingFace кладёт их в домашний
; каталог, а он этому процессу недоступен — ProtectSystem=strict разрешает
; запись только в data. Без этой строки первая же индексация упала бы на
; попытке скачать модель.
Environment=HF_HOME=/opt/llmchat/data/hf
ExecStart=/opt/llmchat/venv/bin/uvicorn research_mcp:app --host 127.0.0.1 --port 8003 --workers 1
Restart=always
RestartSec=3

; Предохранитель по памяти. Модель эмбеддингов вместе с токенизатором bge-m3
; занимает около гигабайта, и один раз она уже утащила сервер поиска под
; OOM-killer, задев всю машину. MemoryHigh заставляет ядро вытеснять именно
; этот процесс в подкачку, не трогая чат; MemoryMax — жёсткий потолок, за
; которым падает только он.
MemoryHigh=900M
MemoryMax=1500M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/llmchat/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
